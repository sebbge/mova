---
import Base from '~/layouts/Base.astro';
import type {Region} from '~/lib/domain/regions';
import StopArrivals from '~/lib/stop/StopArrivals';
import Header from '~/lib/ui/Header';
import {href} from '~/lib/ui/href';
import {regionPaths} from '../_regions';

export const getStaticPaths = regionPaths;

const {region} = Astro.props as {region: Region};
---

<Base title={`Parada, ${region.name} | bondi`} noindex>
  <Header back={href.region(region.slug)} />
  <main>
    <StopArrivals client:only='solid-js' region={region} />
  </main>
</Base>

<style>
  main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
