{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "trailingComma": "es5",
    "bracketSameLine": true,
    "jsxSingleQuote": true,
    "endOfLine": "lf",
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-astro"
    ]
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.6",
    "astro": "^7.4.12",
    "maplibre-gl": "^6.18.0",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.19.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
