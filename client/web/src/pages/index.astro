---
import Base from '~/layouts/Base.astro';
import {REGIONS} from '~/lib/domain/regions';
import LineSearch from '~/lib/line/LineSearch';
import Header from '~/lib/ui/Header.astro';
import {href} from '~/lib/ui/href';
import MapLink from '~/lib/ui/MapLink.astro';
---

<Base
  title='Bondi'
  description='Consultá horarios, recorridos y llegadas en tiempo real de todo el transporte público uruguayo. Buscá tu línea o mirá las paradas cercanas.'>
  <Header />
  <main>
    <section class='hero'>
      <h1>¿Qué bondi te lleva?</h1>
      <p class='lede'>Horarios, recorridos y llegadas en tiempo real del transporte público uruguayo.</p>
      <LineSearch client:idle />
      <MapLink href={href.map()} title='Ver el mapa' sub='Paradas cercanas y buses en vivo' />
    </section>

    <section class='regions'>
      <h2>Regiones</h2>
      <ul>
        {REGIONS.map((region) => (
          <li>
            <a href={href.region(region.slug)}>{region.name}</a>
          </li>
        ))}
      </ul>
      <p class='note'>
        Montevideo y el área metropolitana con todas sus líneas, los interdepartamentales de todo el país, y Maldonado,
        Colonia, Paysandú y Rivera con sus buses en vivo.
      </p>
    </section>
  </main>
</Base>

<style>
  main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lede {
    color: var(--text-secondary);
  }

  .regions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .regions ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .regions a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--divider);
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  @media (hover: hover) {
    .regions a:hover {
      text-decoration: none;
      border-color: var(--brand);
      color: var(--brand);
    }
  }

  .note {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }
</style>
