---
import {PUBLIC_SITE_URL} from 'astro:env/client';
import Base from '~/layouts/Base.astro';
import {api} from '~/lib/api/client';
import {isTerminalStop, orderedRefs, providerInfo, providerOf, serviceOf, stopKicker} from '~/lib/domain/providers';
import type {Region} from '~/lib/domain/regions';
import {fullStopName, rawId} from '~/lib/format';
import LineBadge from '~/lib/line/LineBadge';
import Arrivals from '~/lib/stop/Arrivals';
import Header from '~/lib/ui/Header.astro';
import {href} from '~/lib/ui/href';
import MapLink from '~/lib/ui/MapLink.astro';
import SourceCredit from '~/lib/ui/SourceCredit';
import {stopPaths} from '../../_paths';

export const getStaticPaths = stopPaths;

const {region} = Astro.props as {region: Region};
const stop = await api.stop(Astro.params.id!);
const name = stop.stop_name;
const number = rawId(stop.siblings[0] ?? stop.stop_id);
const siblings = orderedRefs(stop.siblings);
const service = serviceOf(stop.stop_id);
const only = providerInfo(providerOf(stop.stop_id)).only;
const place = fullStopName(name, stop.station);
const kicker = stopKicker(stop.stop_id, name, number, stop.station);
const numbered = service !== 'inter' && !isTerminalStop(name, stop.station);
const label = stop.station ? place : numbered ? `${kicker} · ${name}` : name;
const lineList = stop.lines
  .map((l) => l.line)
  .slice(0, 8)
  .join(', ');

const description = stop.lines.length
  ? `Horarios y llegadas en ${numbered ? `la parada ${number}, ${name}` : place}. Líneas ${lineList}.`
  : `${numbered ? `Parada ${number}, ${name}` : place}, en ${region.name}.`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BusStop',
  name: place,
  identifier: number,
  address: {'@type': 'PostalAddress', addressLocality: region.name, addressCountry: 'UY'},
  geo: {'@type': 'GeoCoordinates', latitude: stop.lat, longitude: stop.lng},
});
---

<Base
  title={`${label} | ${region.name} | Bondi`}
  description={description}
  canonical={`${PUBLIC_SITE_URL}${href.stop(region.slug, stop.stop_id)}`}>
  <script type='application/ld+json' set:html={jsonLd} slot='head' />
  <Header back={href.region(region.slug)} />

  <main>
    <div class:list={['head', service]}>
      <span class='kicker'>{kicker}</span>
      <h1>{name}</h1>

      {siblings.length > 1 ? (
        <nav class='services' aria-label='Tipo de servicio'>
          {siblings.map((ref) => (
            <a
              href={href.stop(region.slug, ref)}
              class:list={{current: ref === stop.stop_id}}
              aria-current={ref === stop.stop_id ? 'page' : undefined}>
              {providerInfo(providerOf(ref)).label}
            </a>
          ))}
        </nav>
      ) : (
        only && <p class='only'>{only}</p>
      )}
    </div>

    <Arrivals client:load stopId={stop.stop_id} split={service === 'inter'} />

    <MapLink href={href.map({parada: stop.stop_id})} title='Ver en el mapa' sub='Dónde vienen los buses, en vivo' />

    <section>
      <h2>Líneas que paran acá</h2>
      {stop.lines.length === 0 ? (
        <p class='note'>Ninguna línea registrada en esta parada.</p>
      ) : (
        <ul class='rows lines'>
          {stop.lines.map((line) => (
            <li>
              <a href={href.line(region.slug, line.line)}>
                <LineBadge line={line.line} size='sm' />
                {line.destinations.length > 0 && <span class='destinations'>{line.destinations.join(' · ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <SourceCredit provider={providerOf(stop.stop_id)} />
  </main>
</Base>

<style>
  main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .head {
    --service: var(--brand-light);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);

    &.suburban {
      --service: var(--service-suburban);
    }

    &.inter {
      --service: var(--service-inter);
    }

    &.neutral {
      --service: var(--service-neutral);
    }
  }

  .kicker,
  .only {
    color: oklch(from var(--service) clamp(var(--tint-text-min), l, var(--tint-text-max)) c h);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .kicker {
    font-variant-numeric: tabular-nums;
  }

  .only {
    margin-top: var(--space-2);
  }

  .services {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);

    a {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
      padding: var(--space-1) var(--space-3);
      border: 1px solid var(--divider);
      border-radius: var(--radius-pill);
      font-size: var(--text-sm);
      color: var(--text-secondary);

      @media (hover: hover) {
        &:hover {
          text-decoration: none;
          border-color: var(--service);
        }
      }

      &:active {
        text-decoration: none;
        border-color: var(--service);
      }

      &.current {
        background: var(--service);
        border-color: var(--service);
        color: var(--service-header-on);
      }
    }
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .note {
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .lines {
    a {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);

      @media (hover: hover) {
        &:hover {
          text-decoration: none;
          background: color-mix(in srgb, var(--brand) 8%, var(--surface));
        }
      }

      &:active {
        text-decoration: none;
        background: color-mix(in srgb, var(--brand) 8%, var(--surface));
      }
    }
  }

  .destinations {
    font-size: var(--text-base);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
