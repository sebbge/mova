---
import Base from '~/layouts/Base.astro';
import Explore from '~/lib/explore/Explore';
import Header from '~/lib/ui/Header.astro';
---

<Base title='Mapa | bondi' noindex>
  <div class='screen'>
    <Header back='/' />
    <div class='canvas'>
      <Explore client:only='solid-js' />
    </div>
  </div>
</Base>

<style>
  .screen {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  .canvas {
    position: relative;
    flex: 1;
    min-height: 0;
  }
</style>
